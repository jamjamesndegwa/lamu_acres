APP_NAME="Lamu Acres"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lamuacres.co.ke

# Show resources/views/errors/500.blade.php instead of the debug exception page for web 500s.
# Defaults to the inverse of APP_DEBUG when unset (friendly when APP_DEBUG=false).
FRIENDLY_ERROR_PAGES=

# Required for `php artisan db:seed` in production (APP_ENV=production).
# Use @lamuacres.co.ke addresses; set non-empty bootstrap passwords before db:seed in production.
# Remove or rotate passwords after first login; do not commit real values.
INITIAL_ADMIN_NAME="Lamu Acres Super Admin"
INITIAL_ADMIN_EMAIL=admin@lamuacres.co.ke
INITIAL_ADMIN_PASSWORD=

INITIAL_STAFF_NAME="Lamu Acres Operations"
INITIAL_STAFF_EMAIL=operations@lamuacres.co.ke
INITIAL_STAFF_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamuacres
DB_USERNAME=
# Wrap in double quotes if the password contains # (starts a comment), $, or spaces.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.lamuacres.co.ke

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_CRITICAL=critical
QUEUE_COMMUNICATIONS=communications
QUEUE_CAMPAIGNS=campaigns
REDIS_QUEUE=default
# Omit on cPanel (defaults to true with database queue). Set false only when queue:work runs permanently.
# COMMUNICATIONS_SYNC_DELIVERY=true

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# cPanel SMTP (port 587 + STARTTLS). Create the mailbox in cPanel before setting MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.lamuacres.co.ke
MAIL_PORT=587
MAIL_USERNAME=info@lamuacres.co.ke
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@lamuacres.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

BULK_SMS_BASE_URL=
BULK_SMS_CLIENT_ID=
BULK_SMS_API_KEY=
BULK_SMS_SENDER_ID=LAMUACRES
BULK_SMS_ENABLED=false
BULK_SMS_DRY_RUN=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=lamuacres
CLOUDFLARE_R2_PUBLIC_URL=

CLOUDFLARE_R2_PRIVATE_ENDPOINT=
CLOUDFLARE_R2_PRIVATE_ACCESS_KEY_ID=
CLOUDFLARE_R2_PRIVATE_SECRET_ACCESS_KEY=
# Leave empty to use CLOUDFLARE_R2_BUCKET_NAME for private uploads (same bucket).
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=

VITE_APP_NAME="${APP_NAME}"

MPESA_DRIVER=unconfigured
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_TIMEOUT_MINUTES=2

LAMU_ALLOW_MANUAL_CONTACT_VERIFICATION=false

# --- Local development (copy block below over the production values above) ---
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://lamuacres.test
# LOG_LEVEL=debug
# SESSION_ENCRYPT=false
# SESSION_DOMAIN=null
# INITIAL_ADMIN_EMAIL=admin@lamuacres.co.ke
# INITIAL_STAFF_EMAIL=operations@lamuacres.co.ke
